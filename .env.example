# Military Technological College - Graduation Bus & Guest Management System
# Production Environment Variables Configuration Template

# Server Port
PORT=5001

# Node Environment ('development' or 'production')
NODE_ENV=production

# JWT Authentication Secret Key (Replace with a strong random 64-char key in production)
JWT_SECRET=replace_with_a_secure_random_production_secret_key_64_chars_min

# Database Connection URL (SQLite default or PostgreSQL connection string)
DATABASE_URL="file:./dev.db"

# Maximum file upload size for Excel imports (in bytes, default 10MB)
MAX_FILE_SIZE_BYTES=10485760
